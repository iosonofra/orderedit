}

/* Smart AI - Google Search style */
.ai-search-btn-wrapper {
  position: relative;
  display: inline-flex;
  align-items: center;
  margin-left: 8px; /* staccato dal menu */
  z-index: 10;
}

/* Outer glow wrapper using pseudo-element */
.ai-search-btn-wrapper::before {
  content: '';
  position: absolute;
  top: -2.5px;
  left: -2.5px;
  right: -2.5px;
  bottom: -2.5px;
  background: linear-gradient(135deg, #34a853, #4285f4, #78ffd6, #fbbc05);
  background-size: 200% 200%;
  border-radius: 999px;
  z-index: 0;
  filter: blur(4px);
  opacity: 0.75;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  animation: AI-gradient-shift 6s ease infinite;
}

.ai-search-btn-wrapper:hover::before {
  filter: blur(6px);
  opacity: 0.95;
  top: -3.5px;
  left: -3.5px;
  right: -3.5px;
  bottom: -3.5px;
}

.ai-search-btn-wrapper.disabled::before {
  opacity: 0;
  filter: none;
}

.ai-search-btn {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 16px;
  border-radius: 999px;
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  border: 1px solid transparent;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

:root[data-theme='light'] .ai-search-btn {
  background: rgba(242, 246, 252, 0.95);
  border-color: rgba(0, 0, 0, 0.08);
  color: #1f1f1f;
}

:root[data-theme='dark'] .ai-search-btn {
  background: rgba(30, 34, 45, 0.95);
  border-color: rgba(255, 255, 255, 0.08);
  color: #e3e3e3;
}

.ai-search-btn:hover:not(:disabled) {
  transform: translateY(-0.5px);
}

:root[data-theme='light'] .ai-search-btn:hover:not(:disabled) {
  background: #ffffff;
  border-color: rgba(0, 0, 0, 0.12);
  color: #0b57d0; /* Soft google blue on text hover */
}

:root[data-theme='dark'] .ai-search-btn:hover:not(:disabled) {
  background: #252a37;
  border-color: rgba(255, 255, 255, 0.15);
  color: #a8c7fa;
}

.ai-search-btn:active:not(:disabled) {
  transform: scale(0.97);
}

.ai-search-btn:disabled {
  background: var(--border) !important;
  color: var(--text-muted) !important;
  border-color: transparent !important;
  box-shadow: none !important;
  cursor: not-allowed;
  opacity: 0.6;
}

.ai-sparkle-icon {
  width: 15px;
  height: 15px;
  color: currentColor;
  transition: transform 0.3s ease;
}

.ai-search-btn:hover:not(:disabled) .ai-sparkle-icon {
  transform: rotate(8deg) scale(1.1);
}

.spinner-small {
  width: 12px;
  height: 12px;
  border: 2px solid rgba(0, 0, 0, 0.1);
  border-top-color: currentColor;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  display: inline-block;
}

:root[data-theme='dark'] .spinner-small {
  border-color: rgba(255, 255, 255, 0.2);
  border-top-color: currentColor;
}

@keyframes AI-gradient-shift {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
</style>
